{
	"$id": "urn:foreman:projects.v1",
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"additionalProperties": false,
	"properties": {
		"projects": {
			"items": {
				"additionalProperties": false,
				"properties": {
					"addedAt": {
						"$ref": "urn:foreman:common#/$defs/timestamp"
					},
					"name": {
						"$ref": "urn:foreman:common#/$defs/shortText"
					},
					"path": {
						"maxLength": 4096,
						"pattern": "^/",
						"type": "string"
					},
					"pinned": {
						"oneOf": [
							{
								"maximum": 9,
								"minimum": 1,
								"type": "integer"
							},
							{
								"type": "null"
							}
						]
					},
					"projectId": {
						"$ref": "urn:foreman:common#/$defs/uuid"
					}
				},
				"required": ["projectId", "name", "path", "addedAt", "pinned"],
				"type": "object"
			},
			"type": "array"
		},
		"schemaVersion": {
			"const": 1
		}
	},
	"required": ["schemaVersion", "projects"],
	"type": "object"
}
