{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Foreman",
	"version": "0.1.0",
	"identifier": "dev.foreman",
	"build": {
		"frontendDist": "../build",
		"devUrl": "http://localhost:5173",
		"beforeDevCommand": "pnpm dev",
		"beforeBuildCommand": "pnpm build"
	},
	"app": {
		"withGlobalTauri": false,
		"windows": [],
		"security": {
			"csp": {
				"default-src": "'self'",
				"script-src": "'self'",
				"style-src": "'self'",
				"img-src": "'self' data:",
				"font-src": "'self'",
				"connect-src": "ipc: http://ipc.localhost",
				"object-src": "'none'",
				"base-uri": "'none'",
				"form-action": "'none'",
				"frame-ancestors": "'none'"
			},
			"devCsp": {
				"default-src": "'self'",
				"script-src": "'self'",
				"style-src": "'self'",
				"img-src": "'self' data:",
				"font-src": "'self'",
				"connect-src": "ipc: http://ipc.localhost http://localhost:5173 ws://localhost:5173",
				"object-src": "'none'",
				"base-uri": "'none'",
				"form-action": "'none'",
				"frame-ancestors": "'none'"
			},
			"freezePrototype": true,
			"dangerousDisableAssetCspModification": false,
			"assetProtocol": {
				"enable": false
			},
			"pattern": {
				"use": "brownfield"
			},
			"capabilities": ["main-window"]
		}
	},
	"bundle": {
		"active": true,
		"targets": ["app"],
		"category": "DeveloperTool",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.png"
		],
		"macOS": {
			"signingIdentity": "-",
			"minimumSystemVersion": "26.0"
		}
	}
}
