{
	"name": "foreman",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Foreman: runs the Claude Build Blueprint stage by stage (macOS, Tauri + SvelteKit 3)",
	"packageManager": "pnpm@12.14.0",
	"engines": {
		"node": ">=22.17"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"dev:mock": "vite dev --mode mock",
		"build": "vite build",
		"preview": "vite preview",
		"preview:mock": "vite build --mode mock && vite preview --mode mock --port 4173 --strictPort",
		"sync": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"typecheck": "svelte-kit sync && tsc --noEmit -p tsconfig.json",
		"lint": "eslint --max-warnings 0 .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:unit": "vitest run --project unit",
		"test:browser": "vitest run --project browser",
		"tauri": "tauri",
		"bindings": "cargo test -p foreman-app --features ts",
		"verify": "node scripts/verify.mjs",
		"verify:fast": "node scripts/verify.mjs --fast",
		"release": "scripts/build-release",
		"test:flows": "playwright test"
	},
	"dependencies": {
		"@tauri-apps/api": "2.12.3"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.64.0",
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.0.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tauri-apps/cli": "2.12.2",
		"@types/node": "22.20.5",
		"@vitest/browser-playwright": "5.0.4",
		"eslint": "10.12.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.1",
		"globals": "17.13.0",
		"playwright": "1.64.0",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.2",
		"svelte-check": "4.7.6",
		"svelte-eslint-parser": "1.9.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.2",
		"vite": "8.3.4",
		"vitest": "5.0.4",
		"vitest-browser-svelte": "3.1.0"
	}
}
